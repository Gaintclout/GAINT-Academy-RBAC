# Docker Compose production variables. Copy to .env.production on the server.
# Never commit the real .env.production file.
POSTGRES_DB=gaint_academy
POSTGRES_USER=gaint_academy
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# Generate a unique random secret (32+ characters). Never reuse the example value.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Comma-separated HTTPS origins only; no wildcard is accepted in production.
CORS_ORIGINS=https://academy.gaintclout.com

# Production safety locks. Keep these values unchanged in production.
APP_ENV=production
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=false
ACCESS_TOKEN_EXPIRE_HOURS=8
